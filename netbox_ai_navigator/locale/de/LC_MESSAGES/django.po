msgid "Open NetBox AI Navigator"
msgstr "NetBox AI Navigator öffnen"

msgid "NetBox AI Navigator"
msgstr "NetBox AI Navigator"

msgid "AI Navigator"
msgstr "AI Navigator"

msgid "Use AI Navigator in read-only mode"
msgstr "AI Navigator im Nur-Lese-Modus verwenden"

msgid "Use AI Navigator with write capabilities"
msgstr "AI Navigator mit Schreibberechtigung verwenden"

msgid "Read-only · your permissions"
msgstr "Nur Lesen · Ihre Berechtigungen"

msgid "Expand assistant"
msgstr "Assistent vergrößern"

msgid "Restore assistant size"
msgstr "Ursprüngliche Assistentengröße wiederherstellen"

msgid "Clear conversation"
msgstr "Unterhaltung zurücksetzen"

msgid "Close assistant"
msgstr "Assistent schließen"

msgid "Ask me about the NetBox data you are permitted to view on this page."
msgstr "Fragen Sie mich nach den NetBox-Daten, die Sie auf dieser Seite sehen dürfen."

msgid "Question"
msgstr "Frage"

msgid "Ask about your NetBox…"
msgstr "Fragen Sie Ihre NetBox…"

msgid "Send question"
msgstr "Frage senden"

msgid "Send"
msgstr "Senden"

msgid "Answers may be inaccurate. Verify important data in NetBox."
msgstr "Antworten können ungenau sein. Prüfen Sie wichtige Angaben in NetBox."

msgid "Thinking…"
msgstr "Denke nach…"

msgid "Request failed with HTTP {status}."
msgstr "Die Anfrage ist mit HTTP {status} fehlgeschlagen."

msgid "The assistant is currently unavailable."
msgstr "Der Assistent ist derzeit nicht verfügbar."

msgid "Reset failed with HTTP {status}."
msgstr "Das Zurücksetzen ist mit HTTP {status} fehlgeschlagen."

msgid "Conversation cleared. What would you like to explore?"
msgstr "Die Unterhaltung wurde zurückgesetzt. Was möchten Sie untersuchen?"

msgid "The conversation could not be cleared."
msgstr "Die Unterhaltung konnte nicht zurückgesetzt werden."

msgid "The model response could not be verified against NetBox data. Please retry or refine the request."
msgstr "Die Modellantwort konnte nicht anhand der NetBox-Daten verifiziert werden. Bitte versuchen Sie es erneut oder präzisieren Sie die Anfrage."

msgid "The tool-call limit was reached before the answer could be verified against NetBox data. Please refine the request."
msgstr "Das Werkzeuglimit wurde erreicht, bevor die Antwort anhand der NetBox-Daten verifiziert werden konnte. Bitte präzisieren Sie die Anfrage."

msgid "Verified NetBox results ({count}):"
msgstr "Verifizierte NetBox-Ergebnisse ({count}):"
